generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  role                   Role      @default(STUDENT)
  isVerified             Boolean   @default(false)
  otp                    String?
  otpExpiresAt           DateTime?
  requiresPasswordChange Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  facultyProfile         Faculty?
  studentProfile         Student?
}

model Faculty {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  department              String?
  moodleId                String?                  @unique
  venue                   String?
  availableDate           DateTime?
  availableTime           String?
  evaluations             Evaluation[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions            Interaction[]
  mentorGrades            MentorGrade[]
  pblFaculties            PblFaculty[]
  reevaluationAssignments ReevaluationAssignment[]
  mentoredTeams           Team[]                   @relation("TeamMentor")
  superMentoredTeams      Team[]                   @relation("TeamSuperMentor")
  phaseEvaluations        TeamPhaseEvaluator[]
}

model Student {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  enrollmentNumber        String                   @unique
  section                 String
  semester                Int                      @default(1)
  phoneNumber             String?
  moodleId                String?
  interactionRecords      InteractionRecord[]
  microMentorEvaluations  MicroMentorEvaluation[]
  reevaluationAssignments ReevaluationAssignment[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledTeams                Team[]                   @relation("TeamLeader")
  teamMembers             TeamMember[]
}

model Pbl {
  id                 String       @id @default(uuid())
  subject            String
  subjectShort       String
  semester           Int
  session            String       @default("2024-2025")
  description        String?
  instructions       String?
  teamFormationStart DateTime?
  teamFormationEnd   DateTime?
  isArchived         Boolean      @default(false)
  createdBy          String?
  registrationSchema Json?
  moodleCourseId     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  pblFaculties       PblFaculty[]
  phases             Phase[]
  teams              Team[]
}

model Team {
  id                     String                  @id @default(uuid())
  pblId                  String
  teamIdFormatted        String                  @unique
  leaderId               String
  mentorId               String?
  mentorIdFormatted      String?
  projectLevel           String?
  customRegistrationData Json?
  projectTitle           String?
  projectDescription     String?
  technologyStack        String?
  githubUrl              String?
  superMentorId          String?
  superMentorStatus      String                  @default("PENDING")
  superMentorFeedback    String?
  superMentorReviewedAt  DateTime?
  createdAt              DateTime                @default(now())
  interactions           Interaction[]
  examineeAssignments    MicroMentorAssignment[] @relation("ExamineeAssignments")
  reviewerAssignments    MicroMentorAssignment[] @relation("ReviewerAssignments")
  submissions            Submission[]
  leader                 Student                 @relation("TeamLeader", fields: [leaderId], references: [id])
  mentor                 Faculty?                @relation("TeamMentor", fields: [mentorId], references: [id])
  superMentor            Faculty?                @relation("TeamSuperMentor", fields: [superMentorId], references: [id])
  pbl                    Pbl                     @relation(fields: [pblId], references: [id], onDelete: Cascade)
  members                TeamMember[]
  phaseEvaluators        TeamPhaseEvaluator[]
}

model TeamMember {
  id        String  @id @default(uuid())
  teamId    String
  studentId String
  status    String  @default("PENDING")
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentId])
}

model Phase {
  id                      String                   @id @default(uuid())
  pblId                   String
  phaseNumber             Int
  instructions            String?
  evaluationCriteria      Json?
  moodleAssignmentId      String?
  submissionStart         DateTime?
  submissionEnd           DateTime?
  evaluations             Evaluation[]
  microMentorAssignments  MicroMentorAssignment[]
  pbl                     Pbl                      @relation(fields: [pblId], references: [id], onDelete: Cascade)
  reevaluationAssignments ReevaluationAssignment[]
  submissions             Submission[]
  teamEvaluators          TeamPhaseEvaluator[]

  @@unique([pblId, phaseNumber])
}

model Submission {
  id           String        @id @default(uuid())
  teamId       String
  phaseId      String
  synopsisUrl  String?
  fileUrls     Json?
  status       String        @default("PENDING")
  submittedAt  DateTime      @default(now())
  mentorGrades MentorGrade[]
  phase        Phase         @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model MentorGrade {
  id           String     @id @default(uuid())
  submissionId String
  mentorId     String
  grade        Int
  remarks      String?
  gradedAt     DateTime   @default(now())
  mentor       Faculty    @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, mentorId])
}

model Evaluation {
  id          String   @id @default(uuid())
  phaseId     String
  studentId   String
  evaluatorId String
  marksData   Json
  totalMarks  Float
  evaluatedAt DateTime @default(now())
  evaluator   Faculty  @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, studentId, evaluatorId])
}

model TeamPhaseEvaluator {
  id              String    @id @default(uuid())
  teamId          String
  phaseId         String
  evaluatorId     String
  status          String    @default("PENDING")
  remarks         String?
  evaluationDate  DateTime?
  evaluationTime  String?
  evaluationVenue String?
  evaluator       Faculty   @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  phase           Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, phaseId])
}

model ReevaluationAssignment {
  id          String  @id @default(uuid())
  studentId   String
  phaseId     String
  evaluatorId String
  status      String  @default("PENDING")
  remarks     String?
  evaluator   Faculty @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  phase       Phase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, phaseId])
}

model SystemSettings {
  id                 String   @id @default("singleton")
  awsAccessKeyId     String?
  awsSecretAccessKey String?
  awsRegion          String?
  awsS3Bucket        String?
  useS3Storage       Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model PblFaculty {
  id                   String  @id @default(uuid())
  pblId                String
  facultyId            String
  mentorIdFormatted    String?
  evaluatorIdFormatted String?
  faculty              Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  pbl                  Pbl     @relation(fields: [pblId], references: [id], onDelete: Cascade)

  @@unique([pblId, facultyId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interaction {
  id             String              @id @default(uuid())
  teamId         String
  mentorId       String
  visitNumber    Int
  date           DateTime            @default(now())
  mentor         Faculty             @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  team           Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentRecords InteractionRecord[]

  @@unique([teamId, visitNumber])
}

model InteractionRecord {
  id            String      @id @default(uuid())
  interactionId String
  studentId     String
  isPresent     Boolean     @default(true)
  remark        String?
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([interactionId, studentId])
}

model MicroMentorAssignment {
  id             String                  @id @default(uuid())
  phaseId        String
  reviewerTeamId String
  examineeTeamId String
  createdAt      DateTime                @default(now())
  examineeTeam   Team                    @relation("ExamineeAssignments", fields: [examineeTeamId], references: [id], onDelete: Cascade)
  phase          Phase                   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  reviewerTeam   Team                    @relation("ReviewerAssignments", fields: [reviewerTeamId], references: [id], onDelete: Cascade)
  evaluations    MicroMentorEvaluation[]

  @@unique([phaseId, reviewerTeamId])
  @@unique([phaseId, examineeTeamId])
}

model MicroMentorEvaluation {
  id                String                @id @default(uuid())
  assignmentId      String
  reviewerStudentId String
  marksData         Json
  totalMarks        Float
  evaluatedAt       DateTime              @default(now())
  assignment        MicroMentorAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewerStudent   Student               @relation(fields: [reviewerStudentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, reviewerStudentId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FACULTY
  STUDENT
}
